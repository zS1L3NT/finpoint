# Google Drive sync (optional — app runs fine without it).
# Paste the Web OAuth client ID from Google Cloud Console, then restart `npm run dev`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only auth broker (never prefixed with NEXT_PUBLIC_: never shipped
# to the browser). GOOGLE_CLIENT_ID mirrors the public client ID above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes as 64 hex chars, e.g. `openssl rand -hex 32`. Seals the
# refresh-token cookie; losing it logs everyone out, leaking it compromises grants.
AUTH_ENCRYPTION_KEY=
