{
	"compilerOptions": {
		"target": "ES2018",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"lib": ["es2021", "dom"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"resolveJsonModule": true,
		"baseUrl": "..",
		"paths": { "@/*": ["src/*"] }
	},
	"exclude": ["remotion.config.ts"]
}
